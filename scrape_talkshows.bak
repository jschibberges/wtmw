    _, maischberger_data = extractShows_Maischberger(url_maischberger)
    all_maischberger_data.extend(maischberger_data)
    save_json_file(DATA_DIR / 'Maischberger_data.json', all_maischberger_data)

    # Scrape Illner
    print("\n-- - Scraping Maybrit Illner --")
